generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  emailVerifiedAt DateTime?
  phone        String? @unique
  phoneVerifiedAt DateTime?
  password     String
  firstName    String?
  lastName     String?
  isActive     Boolean      @default(true)
  role         Role         @default(USER)
  accountTier String @default("BASIC")
  authVersion  Int          @default(0)
  closedAt     DateTime?
  
  wallet       Wallet?
  authTokens   AuthToken[]
  sessions AuthSession[]
  notifications Notification[]
  auditLogs    AuditLog[]
  fundingRequests FundingRequest[]
  beneficiaries Beneficiary[]
  payouts Payout[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("users")
  @@index([createdAt, id], map: "idx_users_date_id")
}

model Wallet {
  ledgerAccount LedgerAccount?
  id                  String        @id @default(uuid())
  balanceMinor        BigInt        @default(0)
  reservedMinor       BigInt        @default(0)
  closedAt            DateTime?
  outgoingFrozen      Boolean @default(false)
  reservations        WithdrawalReservation[]
  fundingRequests     FundingRequest[]
  payouts             Payout[]
  currency            String        @default("NGN")
  
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("wallets")
}

model Transaction {
  reversalOfId String? @unique
  reversalOf Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal Transaction? @relation("TransactionReversal")
  ledgerJournal LedgerJournal?
  id               String            @id @default(uuid())
  amountMinor      BigInt
  currency         String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  referenceId      String            @unique // Crucial for idempotency
  metadata         Json?             // To store provider response, etc.
  
  senderWalletId   String?
  senderWallet     Wallet?           @relation("SentTransactions", fields: [senderWalletId], references: [id])
  
  receiverWalletId String?
  receiverWallet   Wallet?           @relation("ReceivedTransactions", fields: [receiverWalletId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("transactions")
  @@index([senderWalletId, createdAt, id], map: "idx_transactions_sender_date_id")
  @@index([receiverWalletId, createdAt, id], map: "idx_transactions_receiver_date_id")
}

model AuthToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("auth_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

// Customer balances are liabilities (credits increase the customer's balance).
enum LedgerAccountKind {
  CUSTOMER
  CLEARING
  SIMULATION_CLEARING
  FEES
  ADJUSTMENTS
}

enum LedgerSide {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id        String            @id @default(uuid())
  code      String            @unique
  currency  String
  kind      LedgerAccountKind
  walletId  String?           @unique
  wallet    Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime          @default(now())
  entries   LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerJournal {
  id            String        @id @default(uuid())
  reference     String        @unique
  currency      String
  description   String
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime      @default(now())
  // Database write boundary: entries can only be appended in the creating transaction.
  createdXid    BigInt        @default(dbgenerated("txid_current()"))
  entries       LedgerEntry[]

  @@map("ledger_journals")
}

model LedgerEntry {
  id          String        @id @default(uuid())
  journalId   String
  journal     LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  side        LedgerSide
  amountMinor BigInt
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([journalId])
  @@map("ledger_entries")
}


enum ReservationStatus {
  PENDING
  RELEASED
  CAPTURED
}

model WithdrawalReservation {
  payout      Payout?
  id          String @id @default(uuid())
  reference   String @unique
  walletId    String
  wallet      Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  currency    String
  amountMinor BigInt
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([walletId, status])
  @@map("withdrawal_reservations")
}


model WalletRequest {
  key         String @id
  fingerprint String
  response    Json
  createdAt   DateTime @default(now())

  @@map("wallet_requests")
}

enum FundingStatus {
  INITIALIZING
  PENDING
  INITIALIZATION_UNKNOWN
  SUCCESS
  FAILED
}

// Expected payment details are captured before calling the provider.
model FundingRequest {
  id               String @id @default(uuid())
  reference        String @unique
  idempotencyKey   String
  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId         String
  wallet           Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  expectedEmail    String
  amountMinor      BigInt
  currency         String
  provider         String @default("PAYSTACK")
  providerMode     String @default("test")
  status           FundingStatus @default(INITIALIZING)
  authorizationUrl String?
  accessCode       String?
  providerTransactionId String? @unique
  verifiedAt       DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([walletId, createdAt])
  @@map("funding_requests")
}

model PaystackEvent {
  id             String @id
  eventType      String
  reference      String?
  payment        Json
  status         String @default("RECEIVED")
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedUntil    DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@map("paystack_events")
}

model Beneficiary {
  payouts       Payout[]
  id            String @id @default(uuid())
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  bankCode      String
  accountNumber String
  accountName   String
  currency      String @default("NGN")
  provider      String @default("PAYSTACK")
  providerMode  String @default("test")
  verifiedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, bankCode, accountNumber])
  @@index([userId, createdAt])
  @@map("beneficiaries")
  @@index([userId, createdAt, id], map: "idx_beneficiaries_user_date_id")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model Payout {
  id             String @id @default(uuid())
  reference      String @unique
  idempotencyKey String
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId       String
  wallet         Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  beneficiaryId  String
  beneficiary    Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  reservationId  String @unique
  reservation    WithdrawalReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  amountMinor    BigInt
  currency       String @default("NGN")
  providerMode   String @default("test")
  bankCode       String
  accountNumber  String
  accountName    String
  recipientCode  String?
  transferCode   String? @unique
  status         PayoutStatus @default(PENDING)
  providerStatus String?
  uncertain      Boolean @default(false)
  submittedAt    DateTime?
  lockedUntil    DateTime?
  nextCheckAt    DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status, nextCheckAt])
  @@map("payouts")
  @@index([userId, createdAt, id], map: "idx_payouts_user_date_id")
}

model ReconciliationRun {
  id String @id @default(uuid())
  status String @default("RUNNING")
  startedAt DateTime @default(now())
  completedAt DateTime?
  summary Json?
  @@map("reconciliation_runs")
  @@index([startedAt, id], map: "idx_reconciliation_runs_date_id")
}

model ReconciliationIssue {
  id String @id @default(uuid())
  key String @unique
  kind String
  reference String?
  details Json
  status String @default("OPEN")
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  resolvedAt DateTime?
  resolution String?
  @@index([status, lastSeenAt])
  @@map("reconciliation_issues")
  @@index([status, firstSeenAt, id], map: "idx_reconciliation_issues_status_date_id")
}

model FinancialCase {
  id String @id @default(uuid())
  kind String
  providerId String
  fundingId String
  reference String
  walletId String
  providerStatus String
  amountMinor BigInt
  recoveredMinor BigInt @default(0)
  shortfallMinor BigInt @default(0)
  applied Boolean @default(false)
  nextCheckAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([kind, providerId])
  @@index([nextCheckAt])
  @@map("financial_cases")
  @@index([createdAt, id], map: "idx_financial_cases_date_id")
}

model ProviderFee {
  id String @id
  reference String
  kind String
  amountMinor BigInt
  createdAt DateTime @default(now())
  @@map("provider_fees")
  @@index([createdAt, id], map: "idx_provider_fees_date_id")
}

model ReconciliationLease {
  id String @id
  lockedUntil DateTime
  @@map("reconciliation_leases")
}

model SecurityChallenge {
  id String @id @default(uuid())
  userId String
  purpose String
  target String
  codeHash String
  authVersion Int
  binding String?
  action String?
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, createdAt])
  @@map("security_challenges")
}

model StepUpProof {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  action String
  binding String
  authVersion Int
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@map("step_up_proofs")
}

model SecurityDelivery {
  id String @id
  channel String
  recipient String
  payload String?
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@map("security_deliveries")
}

model AuthSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokeReason String?
  tokens SessionRefreshToken[]
  @@index([userId, revokedAt])
  @@map("auth_sessions")
  @@index([userId, revokedAt, createdAt, id], map: "idx_sessions_user_active_date_id")
}

model SessionRefreshToken {
  id String @id
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([sessionId])
  @@map("session_refresh_tokens")
}

model DailyOutgoing {
  id String @id
  userId String
  day String
  amountMinor BigInt @default(0)
  @@unique([userId, day])
  @@map("daily_outgoing")
}
model ActivityFlag {
  id String @id @default(uuid())
  key String @unique
  userId String
  kind String
  status String @default("OPEN")
  details Json
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolution String?
  @@index([status, createdAt])
  @@map("activity_flags")
  @@index([status, createdAt, id], map: "idx_activity_flags_status_date_id")
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventKey String @unique
  kind String
  title String
  body String
  data Json
  readAt DateTime?
  createdAt DateTime @default(now())
  emailStatus String @default("PENDING")
  emailAttempts Int @default(0)
  emailNextAttemptAt DateTime @default(now())
  emailLockedUntil DateTime?
  emailRecipient String?
  @@index([userId, createdAt])
  @@index([emailStatus, emailNextAttemptAt])
  @@map("notifications")
  @@index([userId, createdAt, id], map: "idx_notifications_user_date_id")
  @@index([userId, readAt, createdAt, id], map: "idx_notifications_user_read_date_id")
}
