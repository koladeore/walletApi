generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  firstName    String?
  lastName     String?
  isActive     Boolean      @default(true)
  role         Role         @default(USER)
  authVersion  Int          @default(0)
  
  wallet       Wallet?
  authTokens   AuthToken[]
  auditLogs    AuditLog[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("users")
}

model Wallet {
  ledgerAccount LedgerAccount?
  id                  String        @id @default(uuid())
  balanceMinor        BigInt        @default(0)
  reservedMinor       BigInt        @default(0)
  reservations        WithdrawalReservation[]
  currency            String        @default("NGN")
  
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("wallets")
}

model Transaction {
  ledgerJournal LedgerJournal?
  id               String            @id @default(uuid())
  amountMinor      BigInt
  currency         String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  referenceId      String            @unique // Crucial for idempotency
  metadata         Json?             // To store provider response, etc.
  
  senderWalletId   String?
  senderWallet     Wallet?           @relation("SentTransactions", fields: [senderWalletId], references: [id])
  
  receiverWalletId String?
  receiverWallet   Wallet?           @relation("ReceivedTransactions", fields: [receiverWalletId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("transactions")
}

model AuthToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("auth_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

// Customer balances are liabilities (credits increase the customer's balance).
enum LedgerAccountKind {
  CUSTOMER
  CLEARING
  SIMULATION_CLEARING
  FEES
  ADJUSTMENTS
}

enum LedgerSide {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id        String            @id @default(uuid())
  code      String            @unique
  currency  String
  kind      LedgerAccountKind
  walletId  String?           @unique
  wallet    Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime          @default(now())
  entries   LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerJournal {
  id            String        @id @default(uuid())
  reference     String        @unique
  currency      String
  description   String
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime      @default(now())
  // Database write boundary: entries can only be appended in the creating transaction.
  createdXid    BigInt        @default(dbgenerated("txid_current()"))
  entries       LedgerEntry[]

  @@map("ledger_journals")
}

model LedgerEntry {
  id          String        @id @default(uuid())
  journalId   String
  journal     LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  side        LedgerSide
  amountMinor BigInt
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([journalId])
  @@map("ledger_entries")
}


enum ReservationStatus {
  PENDING
  RELEASED
  CAPTURED
}

model WithdrawalReservation {
  id          String @id @default(uuid())
  reference   String @unique
  walletId    String
  wallet      Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  currency    String
  amountMinor BigInt
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([walletId, status])
  @@map("withdrawal_reservations")
}


model WalletRequest {
  key         String @id
  fingerprint String
  response    Json
  createdAt   DateTime @default(now())

  @@map("wallet_requests")
}
