# Local Docker Compose configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=walletdb

# Required: generate two different random secrets (at least 32 characters).
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# Optional: email sending falls back to the application's local mock key.
RESEND_API_KEY=

# Server-only Paystack integration. Only sk_test_ keys are accepted.
# Copy the test secret from your Paystack dashboard into local .env, never this file.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=

# Authentication code delivery: disabled | test | provider.
# test writes an encrypted local inbox and is rejected in production.
AUTH_DELIVERY_MODE=disabled
# Required distinct random secret (32+ characters) in production.
# Native development falls back to a derived key from JWT_SECRET if blank/omitted.
AUTH_SECURITY_SECRET=
# Verified Resend sender address, required with provider delivery.
AUTH_EMAIL_FROM=

# Simulation is disabled by default and always blocked in production.
# Enable only with NODE_ENV=development or test and a separate test database.
ENABLE_SIMULATED_FUNDING=false

# Used by npm run start:dev; Compose supplies its own production settings.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walletdb?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Development policy defaults; confirm business/compliance limits before launch.
LIMIT_BASIC_TRANSACTION_NGN=50000
LIMIT_BASIC_DAILY_NGN=100000
LIMIT_VERIFIED_TRANSACTION_NGN=100000
LIMIT_VERIFIED_DAILY_NGN=500000

# Notification email uses AUTH_DELIVERY_MODE=provider and existing Resend sender.
NOTIFICATION_EMAIL_ENABLED=true
