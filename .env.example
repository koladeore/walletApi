# Local Docker Compose configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=walletdb

# Required: generate two different random secrets (at least 32 characters).
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# Optional: email sending falls back to the application's local mock key.
RESEND_API_KEY=

# Simulation is disabled by default and always blocked in production.
# Enable only with NODE_ENV=development or test and a separate test database.
ENABLE_SIMULATED_FUNDING=false

# Used by npm run start:dev; Compose supplies its own production settings.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walletdb?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
